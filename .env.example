# Copy to .env.local (on Vercel: Project > Settings > Environment Variables, marked Sensitive).

# Login. Empty ADMIN_PASSWORD = one-button login. Set it to require a password.
ADMIN_PASSWORD=
AUTH_SECRET=            # long random string
CRON_SECRET=            # long random string, used by the cron URL and the webhook URLs

# dry = practice, nothing leaves the app. live = real emails.
SEND_MODE=dry
APP_URL=http://localhost:3200

# Database. Local file by default; on Vercel a Turso database (free).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Brevo > Settings > SMTP & API > SMTP tab
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Resend > API Keys (Sending access)
RESEND_API_KEY=

# The inbox replies arrive in (read only, nothing is changed there)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=info@thesupportlife.com
IMAP_PASS=
